NODE_ENV=production
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=twocents_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/twocents_db?schema=public

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Port Mappings (Host Machine)
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_NGINX_PORT=80
