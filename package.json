{
  "name": "twocents",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:unit": "jest tests/unit --verbose",
    "test:integration": "jest tests/integration --verbose",
    "test:all": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "load-test": "k6 run load-tests/k6-load-test.js",
    "load-test:light": "k6 run --vus 10 --duration 30s load-tests/k6-load-test.js",
    "load-test:medium": "k6 run --vus 100 --duration 1m load-tests/k6-load-test.js",
    "load-test:heavy": "k6 run load-tests/k6-load-test.js",
    "migrate": "node cli/migrate.js all",
    "migrate:status": "node cli/migrate.js status",
    "migrate:up": "node cli/migrate.js up",
    "migrate:down": "node cli/migrate.js down",
    "migrate:create": "node cli/migrate.js create"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mysql2": "^3.6.5",
    "nodemon": "^3.1.10",
    "redis": "^4.6.10"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  }
}
